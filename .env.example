# =============================================================================
# OnlineShop-Compose — local/dev env template (NO real secrets)
# Copy to .env and fill values. Never commit .env or secrets.txt.
# =============================================================================

# PostgreSQL
POSTGRES_DB=OnlineShopDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JWT (backend) — generate: openssl rand -hex 32
JWT_KEY=CHANGE_ME_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ISSUER=OnlineShop
JWT_AUDIENCE=OnlineShopUsers

# Optional first-boot admin (skipped if user already exists)
SEED_ADMIN_PASSWORD=CHANGE_ME

# Backend
BACKEND_PORT=8080

# Docker
DOCKER_USERNAME=your-dockerhub-username
COMPOSE_PROJECT_NAME=shop

# Nginx (dev compose)
NGINX_PORT=80
NGINX_SSL_PORT=443

# Domain / tooling (optional for local)
DOMAIN_NAME=localhost
CERTBOT_EMAIL=you@example.com
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=CHANGE_ME
PORTAINER_PORT=9000
